package sample.serde

import micronaut.core.annotation.Introspected
import micronaut.core.annotation.IntrospectedAccessKind
import micronaut.serde.api.annotation.Serdeable
import micronaut.serde.api.objectMapperGetDefault
import micronaut.serde.api.ObjectMapper

@Serdeable()
@Introspected(accessKind: [IntrospectedAccessKind.FIELD])
class Message {
  String text

  Message(String text) {
    this.text = text
  }
}

Void main() {
  ObjectMapper mapper = objectMapperGetDefault()!!
  String json = mapper.writeValueAsString(Message(text: "Norm"))!!
  Message decoded = mapper.readValue<Message>(arg0: json, arg1: Message.class)!!
  require(condition: decoded.text == "Norm", message: "Typed JSON round trip lost the message")
  printLine(json)
  printLine(decoded.text)
}
